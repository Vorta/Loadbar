#include <windows.h>
#include "loadbar_version.h"
1 ICON "loadbar.ico"
1 VERSIONINFO
FILEVERSION LOADBAR_VERSION_MAJOR,LOADBAR_VERSION_MINOR,LOADBAR_VERSION_PATCH,0
PRODUCTVERSION LOADBAR_VERSION_MAJOR,LOADBAR_VERSION_MINOR,LOADBAR_VERSION_PATCH,0
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Loadbar\0"
            VALUE "FileVersion", LOADBAR_VERSION_STRING "\0"
            VALUE "ProductVersion", LOADBAR_VERSION_STRING "\0"
            VALUE "CompanyName", "Vorta\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Vorta\0"
            VALUE "FileDescription", "Loadbar native system monitor\0"
            VALUE "OriginalFilename", "Loadbar.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
101 RCDATA "../LICENSE"
